ea3bda557885"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"Exp", "[", 
         RowBox[{"u", "/", "b"}], "]"}]}], ")"}], 
      RowBox[{"Cos", "[", "u", "]"}], 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"v", "/", "2"}], "]"}], "^", "2"}]}], ",", 
     RowBox[{"a", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{"u", "/", "b"}], "]"}]}], ")"}], 
      RowBox[{"Sin", "[", "u", "]"}], 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"v", "/", "2"}], "]"}], "^", "2"}]}], ",", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{"u", "/", "c"}], "]"}], "-", 
      RowBox[{"Sin", "[", "v", "]"}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"u", "/", "b"}], "]"}], 
       RowBox[{"Sin", "[", "v", "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "x_", "]"}], "^", 
      RowBox[{"(", 
       RowBox[{"n_", "/;", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"n", ",", "2"}], "]"}], "\[Equal]", "0"}]}], ")"}]}], "\[RuleDelayed]", 
     RowBox[{"x", "^", "n"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assum", "=", 
   RowBox[{
    RowBox[{"a", ">", "0"}], "&&", 
    RowBox[{"b", ">", "0"}], "&&", 
    RowBox[{"c", ">", "0"}], "&&", 
    RowBox[{"u", ">", "0"}], "&&", 
    RowBox[{"0", "<", "v", "<", 
     RowBox[{"2", "\[Pi]"}]}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[174]:=",ExpressionUUID->"685d2ee9-28c3-43c7-a1aa-ce69ab0cad92"],

