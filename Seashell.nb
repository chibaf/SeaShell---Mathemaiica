Cell[BoxData[
 RowBox[{
  RowBox[{"shell", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"Exp", "[", 
         RowBox[{"u", "/", "b"}], "]"}]}], ")"}], 
      RowBox[{"Cos", "[", "u", "]"}], 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"v", "/", "2"}], "]"}], "^", "2"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"a", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{"u", "/", "b"}], "]"}]}], ")"}], 
      RowBox[{"Sin", "[", "u", "]"}], 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"v", "/", "2"}], "]"}], "^", "2"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{"u", "/", "c"}], "]"}], "-", " ", 
      RowBox[{"Sin", "[", "v", "]"}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"u", "/", "b"}], "]"}], 
       RowBox[{"Sin", " ", "[", "v", "]"}]}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[165]:=",ExpressionUUID->"28333390-5385-403f-96d5-aeb29d9f3e32"],

